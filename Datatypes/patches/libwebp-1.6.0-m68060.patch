+// AmigaOS 3.x datatypes: a 68060 has no 64-bit MULU.L/MULS.L and no DIVU.L
+// with a 64-bit dividend; 68060.library emulates each one at 100 cycles or
+// more. GCC uses them for every 32 x 32 -> 64-bit product and for every
+// division by a constant, so the encoder's busiest sums go through these,
+// which give the same results with 16 x 16 -> 32-bit multiplies and 32-bit
+// divides (DIVUL.L) only.
+
+// A divisor GCC can't see, so that x / d is one DIVUL.L and not a multiply
+// by the reciprocal (a 64-bit MULU.L).
+static WEBP_INLINE uint32_t VP8LHiddenDivisor(uint32_t d) {
+#if defined(__GNUC__)
+  __asm__("" : "+r"(d));
+#endif
+  return d;
+}
+
+// The low 16 bits of a times the low 16 bits of b (a MULU.W).
+static WEBP_INLINE uint32_t VP8LMulU16x16(uint32_t a, uint32_t b) {
+  return (uint32_t)(uint16_t)a * (uint32_t)(uint16_t)b;
+}
+
+// a * b, for a < 2^16.
+static WEBP_INLINE uint64_t VP8LMulU16x32(uint32_t a, uint32_t b) {
+  const uint32_t lo = VP8LMulU16x16(a, b);
+  const uint32_t hi = VP8LMulU16x16(a, b >> 16);
+  return ((uint64_t)hi << 16) + lo;
+}
+
+// a * b.
+static WEBP_INLINE uint64_t VP8LMulU32x32(uint32_t a, uint32_t b) {
+  return ((uint64_t)VP8LMulU16x16(a >> 16, b >> 16) << 32) +
+         VP8LMulU16x16(a, b) + ((uint64_t)VP8LMulU16x16(a, b >> 16) << 16) +
+         ((uint64_t)VP8LMulU16x16(a >> 16, b) << 16);
+}
+
+// x * s modulo 2^64, as x * s, for s < 2^16.
+static WEBP_INLINE uint64_t VP8LMulU64x16(uint64_t x, uint32_t s) {
+  return ((uint64_t)((uint32_t)(x >> 32) * s) << 32) +
+         VP8LMulU16x32(s, (uint32_t)x);
+}
+
+// DivRound(a, d) for a >= 0 and 0 < d < 2^16: three 32-bit divides, a
+// 16-bit piece of a at a time.
+static WEBP_INLINE uint64_t VP8LDivRoundU64(uint64_t a, uint32_t d) {
+  const uint32_t dd = VP8LHiddenDivisor(d);
+  uint32_t hi, mid, lo, r;
+  a += d >> 1;
+  hi = (uint32_t)(a >> 32) / dd;
+  r = (uint32_t)(a >> 32) % dd;
+  mid = ((r << 16) | ((uint32_t)a >> 16)) / dd;
+  r = ((r << 16) | ((uint32_t)a >> 16)) % dd;
+  lo = ((r << 16) | (uint16_t)a) / dd;
+  return ((uint64_t)hi << 32) + ((mid << 16) | lo);
+}
+
+// DivRound(x * m, 100) for an even m < 100: one 32-bit divide.
+// (m * x + 50) / 100 = (m/2 * x + 25) / 50; with x = 50 q + r, that is
+// m/2 * q + (m/2 * r + 25) / 50, and t / 50 = (t * 1311) >> 16 for t < 4681.
+static WEBP_INLINE uint32_t VP8LDivRoundMulBy100(uint32_t x, uint32_t m) {
+  const uint32_t d = VP8LHiddenDivisor(50);
+  const uint32_t q = x / d, r = x % d;
+  return (m >> 1) * q + ((((m >> 1) * r + 25) * 1311) >> 16);
+}
